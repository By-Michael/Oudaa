generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN       // committee member — manages one community
  RESIDENT
}

enum ResidentStatus {
  ACTIVE
  INACTIVE
  MOVED_OUT
}

// Platform-admin-controlled only — see Community.status comment above.
enum CommunityStatus {
  ACTIVE
  SUSPENDED
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

// Which real-world provider a CommunityPaymentMethod represents. Product
// decision: Hivee only supports CBE and Telebirr — these are the two
// rails Veritas (bankVerification.js) has dedicated, reliable adapters
// for and cover the overwhelming majority of Ethiopian resident
// payments. Previously also had DASHEN/ABYSSINIA/CBEBIRR/MPESA/
// BANK_OTHER — removed (see migration 20260827040000_narrow_payment_providers).
enum PaymentProvider {
  CBE
  TELEBIRR
}

enum PaymentStatus {
  PENDING
  // Bank verification returned matched:true, but our own safeguard check
  // (payer-name mismatch, amount outside tolerance, above the auto-verify
  // threshold, or the provider response didn't have enough fields to
  // cross-check confidently) didn't clear it for instant VERIFIED. Needs
  // an admin to look at it — distinct from PENDING because there IS a
  // bank match on file, just not a fully-trusted one.
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  SECURITY
  WATER
  CLEANING
  MAINTENANCE
  IMPROVEMENT
  ADMIN
  OTHER
}

enum TransferRequestStatus {
  PENDING_COMMITTEE  // waiting on other committee members to approve
  PENDING_RECIPIENT  // committee approved, waiting on the chosen resident
  APPROVED           // fully accepted, transfer executed
  REJECTED           // rejected by a committee member or the recipient
  CANCELLED          // withdrawn by the requester
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// TENANT ROOT
// ---------------------------------------------------------------------------

model Community {
  id          String   @id @default(uuid())
  name        String
  // URL-safe, globally-unique handle used for the community's subdomain
  // (e.g. "acme" -> acme.oudaa.app). Generated from `name` at signup
  // (see slugify.js) and editable later from community settings, so long
  // as the new value is still unique. Every tenant on the shared DB is
  // reachable this way instead of needing its own database/deployment.
  slug        String   @unique
  address     String?
  contactInfo String?
  // Platform-level operational status, set only by platform admins (see
  // src/routes/platformAdmin) — NOT visible to or settable by the
  // community's own admins/residents, and orthogonal to any
  // community-internal concept. Checked at community login (see
  // authController.js) so a suspended community can't be signed into
  // again, but deliberately NOT checked in the hot-path authenticate
  // middleware — adding a Community lookup to every authenticated
  // request platform-wide is a real perf/behavior change outside Phase
  // 2's scope (dashboard + search), so an already-issued token stays
  // valid until it expires even after suspension. Enforcing immediate
  // mid-session cutoff is a Communities-management feature for a later
  // phase. Added now specifically so "active/suspended communities"
  // counts on the platform dashboard are real, not fabricated.
  status      CommunityStatus @default(ACTIVE)
  suspendedAt DateTime?
  suspendedReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Bank account residents are told to pay into (shown + copy-buttoned in
  // the resident "Make a payment" flow). One fixed account per community.
  paymentBankName       String?
  paymentAccountName    String?
  paymentAccountNumber  String?
  // Self-verified payments at or above this amount always go to
  // PENDING_REVIEW regardless of bank-match quality (fraud incentive
  // concentrates at higher amounts). Null/unset = no threshold, only the
  // name/amount cross-check safeguards apply. See selfVerifyPayment.
  autoVerifyMaxAmount   Decimal?  @db.Decimal(12, 2)

  users    User[]
  residents Resident[]
  fees     Fee[]
  funds    Fund[]
  projects Project[]
  payments Payment[]
  expenses Expense[]
  receipts Receipt[]
  transferRequests CommitteeTransferRequest[]
  transferApprovals CommitteeTransferApproval[]
  pendingChanges   PendingChange[]
  pendingChangeApprovals PendingChangeApproval[]
  auditLogs AuditLog[]
  bankAccountHistory CommunityBankAccountHistory[]
  autoApprovals      CommitteeAutoApproval[]
  paymentMethods     CommunityPaymentMethod[]
  projectFundAllocations ProjectFundAllocation[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  supportChatMessages    SupportChatMessage[]
  supportTickets         SupportTicket[]
  featureFlagTargets     PlatformFeatureFlagTarget[]
  announcementTargets    PlatformAnnouncementTarget[]

  @@index([status])
  @@map("communities")
}

// A committee can register more than one way to receive money — their CBE
// account and/or a Telebirr number (see PaymentProvider). Residents pick
// one of these — instead of the single fixed
// paymentBankName/paymentAccountName/paymentAccountNumber on Community
// above, which is kept only for backward compatibility with communities
// that haven't added any of these yet (see paymentController.js fallback).
//
// Field usage differs by provider, enforced in paymentMethodValidators.js
// rather than the schema (Postgres can't express "required only when
// provider = X"):
//   - TELEBIRR has no bank account at all — only fullName + phoneNumber
//     are used; bankName/accountName/accountNumber stay null.
//   - CBE uses bankName/accountName/accountNumber (shown for display
//     purposes even though residents no longer type a suffix — see
//     selfVerifyPayment's CBE branch, receipt-upload only).
model CommunityPaymentMethod {
  id            String          @id @default(uuid())
  communityId   String
  provider      PaymentProvider
  // Short display name the resident sees in the picker, e.g. "CBE — Main
  // Account", "Telebirr — Security Deposits". Defaults to the provider's
  // generic name in the UI if left blank.
  label         String
  bankName      String?
  accountName   String?
  accountNumber String?
  // Telebirr-only — since Telebirr has no bank account, residents send to
  // (and identify) the committee by these two fields instead.
  fullName      String?
  phoneNumber   String?
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([communityId])
  @@map("community_payment_methods")
}

// Snapshot of a community's bank payment account every time it's changed
// (via the COMMUNITY_PAYMENT_DETAILS pending-change flow — see
// pendingChanges.js apply()). Exists so a payment sent to an account that
// was correct *at the time* but has since been replaced isn't treated as
// a fraud-flavored mismatch during verification — see
// paymentController.js's receiverAccount cross-check, which checks this
// table before flagging. `replacedAt` is when this account STOPPED being
// current (i.e. when the next change took effect), not when it started.
model CommunityBankAccountHistory {
  id            String   @id @default(uuid())
  communityId   String
  bankName      String?
  accountName   String?
  accountNumber String?
  replacedAt    DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([accountNumber])
  @@map("community_bank_account_history")
}

// ---------------------------------------------------------------------------
// CORE ENTITIES
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  communityId  String?  // nullable while a user's community assignment is pending
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RESIDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Profile picture — stored in object storage (Supabase Storage, same
  // pattern as Receipt.fileUrl/storageKey), not on the client. Lets the
  // avatar follow the user across devices instead of living only in one
  // browser's localStorage.
  avatarUrl     String?
  avatarStorageKey String?
  // Cross-device user preferences (theme, sidebar-collapsed, default
  // export format, per-category notification mutes, etc). A single JSON
  // column rather than a table per preference — these are small, loosely
  // structured, per-user settings with no query/reporting need of their
  // own, so a dedicated relational table per setting would be pure
  // overhead. Read/written as a shallow merge via PATCH /users/me/preferences.
  preferences   Json?          @default("{}")

  community     Community?     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  resident      Resident?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  profileChangeOtps ProfileChangeOtp[]
  verifiedPayments Payment[]  @relation("PaymentVerifiedBy")
  recordedPayments Payment[]  @relation("PaymentRecordedBy")
  recordedExpenses Expense[]  @relation("ExpenseRecordedBy")

  transferRequestsInitiated CommitteeTransferRequest[]   @relation("TransferFrom")
  transferApprovals         CommitteeTransferApproval[]
  pendingChangesProposed    PendingChange[]               @relation("PendingChangeProposedBy")
  pendingChangeApprovals    PendingChangeApproval[]
  autoApprovals             CommitteeAutoApproval[]
  auditLogs                 AuditLog[]
  supportChatSessions       SupportChatSession[]
  supportTickets            SupportTicket[]
  supportTicketMessages     SupportTicketMessage[]

  @@index([communityId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// HELP & SUPPORT — AI ASSISTANT ("Ask Oudaa AI")
//
// A per-user chat session with the Groq-backed support assistant (see
// src/utils/supportAiAssistant.js). Sessions are ephemeral by default —
// the frontend keeps an in-memory conversation and only ever calls
// POST /support/chat/sessions to actually persist one once the user
// explicitly opts in ("Save this conversation"). `saved=false` rows are
// not created at all; there is no "unsaved session" row sitting in the
// DB, since the user may never opt in.
// ---------------------------------------------------------------------------

model SupportChatSession {
  id          String   @id @default(uuid())
  userId      String
  // Denormalized at creation time so a committee member's saved sessions
  // stay scoped to their community even if their own communityId ever
  // changes later (transfer, etc.) — mirrors Payment.communityId reasoning.
  communityId String?
  // Short auto-generated label from the first user message, editable
  // later — shown in the "saved conversations" list.
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportChatMessage[]
  escalatedToTickets SupportTicket[]

  @@index([userId])
  @@index([communityId])
  @@map("support_chat_sessions")
}

model SupportChatMessage {
  id        String   @id @default(uuid())
  // Denormalized from session.communityId — nullable because
  // SupportChatSession.communityId is itself nullable. See migration
  // 20260908000000_communityid_everywhere.
  communityId String?
  sessionId String
  // "user" | "assistant" — mirrors the Groq/OpenAI chat message role.
  // Tool-call plumbing (which internal query the assistant ran) is never
  // persisted, only the resulting user-facing text, so saved transcripts
  // stay small and readable.
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  community Community?          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  session SupportChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([communityId])
  @@map("support_chat_messages")
}

// ---------------------------------------------------------------------------
// PLATFORM SUPPORT TICKETS (Phase 4)
//
// A real ticketing system, distinct from SupportChatSession/Message above
// (which remain exactly what they were: a resident/admin's own saved AI
// assistant conversations). A SupportTicket can optionally reference the
// AI conversation it was escalated from (originConversationId) but is
// otherwise a completely separate object — platform support staff work
// tickets, not chat sessions, and nothing about this model changes how
// the community-facing AI assistant behaves.
//
// SECURITY BOUNDARY: there is no community-facing route anywhere in this
// codebase that reads SupportTicket/SupportTicketMessage. Every route that
// touches these lives under src/routes/platformAdmin and requires
// authenticatePlatformAdmin. Internal notes (SupportTicketMessage.isInternalNote)
// are therefore never reachable by a community user by construction, not
// by a runtime filter that could be forgotten on some future endpoint.
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketCategory {
  ACCOUNT
  PAYMENT
  COMMUNITY
  TECHNICAL
  SECURITY
  FINANCIAL
  BUG
  FEATURE_REQUEST
  OTHER
}

model SupportTicket {
  id          String                 @id @default(uuid())
  // Nullable for the same reason Payment/SupportChatSession.communityId
  // are — a ticket can in principle concern a user not yet tied to a
  // community, or a community that was later removed.
  communityId String?
  userId      String
  subject     String
  description String                 @db.Text
  status      SupportTicketStatus    @default(OPEN)
  priority    SupportTicketPriority  @default(NORMAL)
  category    SupportTicketCategory  @default(OTHER)
  // The platform operator currently responsible for this ticket. Nullable
  // — an unassigned ticket is a real, common state (see the "Unassigned"
  // inbox section), not an error state.
  assignedToId String?
  // Set when this ticket was opened directly from an AI assistant
  // conversation the user was already having (a human escalation) —
  // distinct from a ticket a support agent or the platform itself opens
  // with no prior AI conversation. Powers "AI vs human support" and
  // "human escalations" analytics honestly, from a real link, rather than
  // a guessed heuristic.
  originConversationId String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  closedAt       DateTime?
  // Last time ANY message (customer or agent) was added — drives
  // "Waiting for user" bookkeeping and sorting the inbox by recency of
  // activity rather than just creation date.
  lastResponseAt DateTime?

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  community         Community?           @relation(fields: [communityId], references: [id], onDelete: SetNull)
  assignedTo        PlatformAdmin?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  originConversation SupportChatSession? @relation(fields: [originConversationId], references: [id], onDelete: SetNull)
  messages          SupportTicketMessage[]

  @@index([communityId])
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  // Exactly one of these two is set, never both — enforced in
  // application code (platformSupportTicketService.js), same pattern as
  // several other "one of two possible authors" fields elsewhere in this
  // schema (e.g. PendingChangeApproval).
  authorUserId          String?
  authorPlatformAdminId String?
  // The customer/agent distinction the UI must always show clearly (Phase
  // 4's explicit requirement) is fully determined by which author field
  // is set — no separate redundant flag needed for that part. This flag
  // covers the ORTHOGONAL distinction: even an agent's message can be a
  // customer-visible reply or an internal-only note.
  isInternalNote Boolean  @default(false)
  body           String   @db.Text
  createdAt      DateTime @default(now())
  editedAt       DateTime?

  ticket             SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser         User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorPlatformAdmin PlatformAdmin? @relation(fields: [authorPlatformAdminId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("support_ticket_messages")
}

// Real, append-only telemetry for the AI support assistant (Phase 4's
// "request count / failures / latency / recent errors" requirement).
// Nothing before this model existed to answer those questions honestly —
// see supportAiAssistant.js, which previously only console.error'd
// failures. Written best-effort (a logging failure must never break an
// actual support response) from within that same file going forward;
// history only exists from when this was added, which is disclosed
// wherever these metrics are shown rather than implied to be complete.
model SupportAiRequestLog {
  id           String   @id @default(uuid())
  provider     String   @default("groq")
  model        String
  success      Boolean
  latencyMs    Int
  errorMessage String?
  sessionId    String?
  userId       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([success])
  @@map("support_ai_request_logs")
}

// ---------------------------------------------------------------------------
// SYSTEM AUDIT LOG
//
// An append-only trail of every meaningful action taken by committee
// members (and platform staff) inside a community. Every committee member
// can VIEW the full log for their community, but nothing here is ever
// editable or deletable through the API — no update/delete route exists
// for this model on purpose.
// ---------------------------------------------------------------------------

model AuditLog {
  id          String    @id @default(uuid())
  communityId String?
  actorId     String?
  actorName   String
  actorRole   UserRole
  action      String    // e.g. CREATE, UPDATE, DELETE, VERIFY, REJECT, LOGIN
  entityType  String    // e.g. Resident, Fee, Payment, Fund, Project, Expense
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime  @default(now())

  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([communityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  // Denormalized from user.communityId — nullable because User.communityId
  // itself is nullable (see User model). See migration
  // 20260908000000_communityid_everywhere.
  communityId String?
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([communityId])
  @@map("refresh_tokens")
}

// Forgot-password flow. Mirrors RefreshToken's pattern: only a hash of the
// token is ever stored, so a DB dump alone can't be used to reset anyone's
// password. Single-use (consumedAt) and short-lived (expiresAt), separate
// from RefreshToken so a password-reset link can't be repurposed as a
// login/refresh token or vice versa.
model PasswordResetToken {
  id         String    @id @default(uuid())
  // Denormalized from user.communityId — nullable for the same reason as
  // RefreshToken.communityId. See migration
  // 20260908000000_communityid_everywhere.
  communityId String?
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([communityId])
  @@map("password_reset_tokens")
}

// Email-verified OTP gate for the two self-service profile changes that
// warrant it: a resident changing their phone number (used for phone
// login — see authController.login) or their profile picture. Committee
// (ADMIN) users skip this entirely for avatar changes (see
// userController.uploadAvatar) since it's low-stakes for them; residents
// go through it for both. One row per requested change: `payload` carries
// whatever the change needs to apply once verified (e.g. { phone } for a
// PHONE request — AVATAR has no payload since the file itself arrives
// with the verify call). Only the OTP's hash is stored, same pattern as
// PasswordResetToken/RefreshToken. `attempts` caps guesses per code
// before it's dead regardless of expiresAt, since a 6-digit code has far
// less entropy than a reset token and is worth rate-limiting on its own.
model ProfileChangeOtp {
  id         String    @id @default(uuid())
  userId     String
  type       String    // 'PHONE' | 'AVATAR'
  payload    Json?
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("profile_change_otps")
}

model Resident {
  id          String        @id @default(uuid())
  // Denormalized from user.communityId (see migration
  // 20260908000000_communityid_everywhere) so every tenant-scoped query
  // — list/search/count residents — is a direct indexed equality filter
  // instead of joining out to `users` first, matching the same pattern
  // already used by Payment/Expense/Fund/etc.
  communityId String
  userId     String         @unique
  unitNumber String
  phone      String?
  // Last 9 digits of `phone`, stripped of everything but numbers, kept in
  // sync whenever `phone` is written. Login-by-phone looks this up with a
  // plain indexed equality match instead of pulling every resident with a
  // phone number into Node and scanning them there (see authController.js).
  phoneSearchKey String?    @db.VarChar(9)
  idNumber   String?
  address    String?
  ownerType  String?        @default("OWNER") // OWNER | RENTER
  status     ResidentStatus @default(ACTIVE)
  // Why this resident was set to INACTIVE/MOVED_OUT — picked from a preset
  // list of common reasons (e.g. "Non-payment of fees") or free-typed by
  // the committee member, captured at the moment of deactivation (see
  // deactivateResident in residentController.js). Null while ACTIVE.
  inactiveReason   String?
  // When the resident was last deactivated. Cleared on reactivation. Kept
  // separate from `updatedAt` (which changes on any profile edit) so the
  // UI/audit trail can show exactly when the account was shut off.
  inactivatedAt    DateTime?
  joinedAt   DateTime       @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]
  incomingTransferRequests CommitteeTransferRequest[] @relation("TransferTo")

  @@index([phoneSearchKey])
  @@index([communityId])
  @@map("residents")
}

model Fee {
  id          String       @id @default(uuid())
  communityId String
  name        String
  amount      Decimal      @db.Decimal(12, 2)
  frequency   FeeFrequency @default(MONTHLY)
  dueDay      Int? // day of month/quarter fee is due
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([communityId])
  @@map("fees")
}

model Payment {
  id                 String        @id @default(uuid())
  // Denormalized from residentId (a resident's community, always the same
  // community the fee/project/fund being paid belongs to). Lets every
  // community-scoped payment query use a plain indexed filter instead of
  // joining out through fee/project/fund to find the community — see
  // migration 20260813052537_denormalize_community_id.
  communityId        String
  residentId         String
  // Exactly one of feeId / projectId / fundId is set — what this payment is
  // *for*. All nullable (rather than a single polymorphic column) so the
  // existing FK integrity/cascade behaviour keeps working for whichever one
  // is used. Enforced in the app layer (paymentValidators.js) since Postgres
  // check constraints referencing three nullable columns aren't expressible
  // in the Prisma schema directly.
  //
  // fundId is for a resident paying directly into a Fund (e.g. topping up
  // "Emergency Fund" with no specific project yet). Contrast with a payment
  // on a Project that itself belongs to a fund — both count toward that
  // fund's real cash balance (see Fund.actualBalance in fundController.js),
  // but only fundId payments have no project attached at all. Fee payments
  // never set fundId and never count toward any fund's balance — fees pay
  // for operating costs, not fund-linked projects.
  feeId              String?
  projectId          String?
  fundId             String?
  amount             Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(CASH)
  // Which of the community's configured payment methods (see
  // CommunityPaymentMethod) a resident's self-verified payment was sent
  // through. Null for manually-recorded (cash/in-person) payments and for
  // self-verified payments made before this existed (single-account
  // fallback — see selfVerifyPayment). SetNull so deleting a payment
  // method later doesn't touch historical payment records.
  paymentMethodId    String?
  transactionReference String?
  // Which calendar month(s) a *fee* payment counts toward, e.g. "2026-08"
  // (one month) or "2026-06,2026-07,2026-08" (a committee member catching
  // a resident up on several unpaid months in one go). Null for
  // project/fund payments, and for older fee payments recorded before
  // this existed — those just have no month attached to display.
  paidForMonth       String?
  // Name typed in by the resident submitting the payment — the person who
  // actually sent the money, which may not be the resident themselves
  // (e.g. a family member paying on their behalf). Kept separate from the
  // resident's own profile name for that reason.
  payerName          String?
  // Optional free-text note the resident can attach (e.g. "August dues").
  reason             String?
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime      @default(now())
  verifiedBy         String?
  // Optional photo/PDF of the physical receipt — only meaningful for
  // committee-recorded (cash/in-person) payments; residents' bank transfers
  // are verified against the bank instead.
  receiptUrl         String?
  // Set only when a committee member records this payment on a resident's
  // behalf (cash-in-hand, no bank access, etc). Null for a resident's own
  // self-verified payment. This is what gates the edit/delete buttons in
  // the admin UI — self-verified bank payments stay append-only, but a
  // manually-typed entry can be fixed or removed by the committee since a
  // human, not a bank, is the source of truth for it.
  recordedBy         String?
  // Raw bank-verification provider response (Veritas), kept for admin
  // review of PENDING_REVIEW / VERIFIED self-verified payments — lets a
  // human see exactly what the bank lookup returned rather than just our
  // pass/fail summary of it. Null for non-self-verified payments.
  verificationRaw    Json?
  // Human-readable reason(s) our safeguard check flagged this payment for
  // review (e.g. "payer name mismatch", "amount above auto-verify
  // threshold"). Null when it passed cleanly or wasn't self-verified.
  reviewFlags        String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  fee      Fee?     @relation(fields: [feeId], references: [id], onDelete: Cascade)
  // SetNull (not Cascade) — a payment is an append-only financial record
  // (see recordedBy/verifiedBy comments above) and must survive its
  // project or fund being deleted, the same way Expense.project already
  // does. Deleting a Project/Fund now just detaches the payment from it
  // rather than erasing what a resident actually paid; see deleteFund in
  // fundController.js for the balance/pending-payment checks that gate
  // fund deletion in the first place.
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fund     Fund?    @relation(fields: [fundId], references: [id], onDelete: SetNull)
  verifier User?    @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)
  recorder User?    @relation("PaymentRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)
  paymentMethodUsed CommunityPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([residentId])
  @@index([feeId])
  @@index([projectId])
  @@index([fundId])
  @@index([communityId])
  // Every list/report/aggregate query filters or sorts on these — without
  // an index Postgres has to scan and sort the whole table, which gets
  // slower every month as more payments accumulate.
  @@index([status])
  @@index([paidAt])
  @@index([communityId, paidAt])
  @@map("payments")
}

model Fund {
  id          String   @id @default(uuid())
  communityId String
  name        String
  // Broad grouping shown as a badge/color in the UI (Security, Utilities,
  // Maintenance, Development, ...). Free-text on purpose — was previously
  // smuggled into `description` below (see git history / adapters.js),
  // which meant a fund could never actually have its own notes. Split out
  // into its own column so the two don't collide.
  category    String?
  // Optional free-text note on why this fund exists / what it's earmarked
  // for beyond what the name says (e.g. "Set up after the March 2026
  // flooding to cover future drainage work"). Purely informational.
  description String?
  // Optional fundraising target the committee sets for this fund, shown as
  // progress-toward-goal in the UI. Previously kept client-side only
  // (localStorage `fundGoal` overlay) — now a real column so it's visible
  // to every device/admin instead of only the browser that set it.
  goal        Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  projects  Project[]
  // Direct-to-fund payments only (see Payment.fundId comment). Payments
  // aimed at a Project that belongs to this fund are NOT in this relation —
  // they're reached via project.fundId instead. Fund balance calculations
  // must combine both; see getFundSummary in fundController.js.
  payments  Payment[]
  projectAllocations ProjectFundAllocation[]
  // Direct-to-fund expenses only (see Expense.fundId comment) — a
  // committee member spending straight out of a fund with no project
  // attached. Mirrors the payments relation above.
  expenses  Expense[]

  @@index([communityId])
  @@map("funds")
}

model Project {
  id          String        @id @default(uuid())
  communityId String
  fundId      String
  name        String
  description String?
  budget      Decimal       @db.Decimal(12, 2)
  status      ProjectStatus @default(PLANNED)
  // Mandatory once status = CANCELLED, enforced in pendingChanges.js
  // (PROJECT_CANCELLATION change type) rather than at the DB layer, since
  // cancellation always goes through committee approval and never a
  // direct update.
  cancelReason String?
  startDate   DateTime
  endDate     DateTime?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  fund      Fund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  payments  Payment[]
  fundAllocations ProjectFundAllocation[]

  @@index([communityId])
  @@index([fundId])
  @@map("projects")
}

// A project's budget can be funded from more than one fund account. `Fund`
// remains a required single field on Project for backward compatibility
// and as the "primary" fund (used for default filtering/reporting), but the
// real money breakdown lives here. Sum of ProjectFundAllocation.amount for
// a project must equal Project.budget — enforced in projectValidators.js /
// projectController.js, not the DB, since Decimal cross-row sums aren't a
// Postgres CHECK constraint Prisma can express cleanly.
model ProjectFundAllocation {
  id        String  @id @default(uuid())
  // Denormalized from project.communityId (== fund.communityId) — see
  // migration 20260908000000_communityid_everywhere.
  communityId String
  projectId String
  fundId    String
  amount    Decimal @db.Decimal(12, 2)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fund    Fund    @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([projectId, fundId])
  @@index([fundId])
  @@index([communityId])
  @@map("project_fund_allocations")
}

model Expense {
  id          String          @id @default(uuid())
  // Denormalized from recordedBy's community — see Payment.communityId
  // comment and migration 20260813052537_denormalize_community_id for why.
  communityId String
  projectId   String?
  // Direct-to-fund expense: a committee member spending straight out of a
  // fund's real cash with no project attached (e.g. an unplanned repair).
  // Mirrors Payment.fundId — at most one of projectId/fundId is set; both
  // may be empty for a general community expense checked only against the
  // community's overall balance (see computeCommunityBalance in
  // expenseController.js). `reason` is mandatory whenever fundId is set
  // (enforced in expenseValidators.js) since there's no project budget
  // line to justify the spend against.
  fundId      String?
  reason      String?
  recordedBy  String
  category    ExpenseCategory @default(OTHER)
  description String?
  vendor      String?
  amount      Decimal         @db.Decimal(12, 2)
  spentAt     DateTime        @default(now())
  bankName    String?
  transactionReference String?
  // When the ROW was recorded, distinct from spentAt (which is when the
  // money went out and can be backdated). The delete grace window in
  // expenseController.js measures against this, not spentAt, so someone
  // can't reopen the delete window on an old expense by editing its date.
  createdAt   DateTime        @default(now())

  // Expenses are effectively append-only: a correction is a new Expense row
  // that offsets the original rather than a mutation of it. `reversesId` is
  // set ONLY on the reversal row and points back at the original it cancels
  // out (reversal amount is stored negative so budget/actual-spend sums —
  // see computeFundMoney in fundController.js — net out with zero special
  // casing). `isVoided` is set on the ORIGINAL once it has been reversed, so
  // listings can flag/exclude it visually without needing to inspect the
  // reverse relation. A row can never be both voided and a reversal of
  // something else at once in normal flow, but nothing here prevents
  // re-reversing a reversal if that's ever needed (each reversal is just
  // another Expense).
  reversesId  String?   @unique
  isVoided    Boolean   @default(false)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fund     Fund?     @relation(fields: [fundId], references: [id], onDelete: SetNull)
  recorder User      @relation("ExpenseRecordedBy", fields: [recordedBy], references: [id], onDelete: Restrict)
  receipts Receipt[]
  reverses  Expense? @relation("ExpenseReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversal  Expense? @relation("ExpenseReversal")

  @@index([projectId])
  @@index([fundId])
  @@index([recordedBy])
  @@index([spentAt])
  @@index([communityId])
  @@index([communityId, spentAt])
  @@map("expenses")
}

model Receipt {
  id         String   @id @default(uuid())
  // Denormalized from expense.communityId — see migration
  // 20260908000000_communityid_everywhere.
  communityId String
  expenseId  String
  fileUrl    String
  // Object key/filename used to delete the underlying file from storage
  // (Supabase Storage key, or local filename — see src/config/storage.js).
  // Nullable because receipts uploaded before this field existed only
  // have fileUrl; deleteReceiptFile() no-ops gracefully when it's null.
  storageKey String?
  uploadedAt DateTime @default(now())
  // Whether a committee member has confirmed this receipt matches the
  // expense it's attached to. Previously tracked client-side only
  // (localStorage, keyed by receipt id) — now a real column so the
  // verification status is shared across every admin/device instead of
  // resetting per-browser.
  verified   Boolean  @default(false)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([communityId])
  @@map("receipts")
}

// ---------------------------------------------------------------------------
// COMMITTEE MEMBERSHIP TRANSFER
//
// A committee member (User.role = ADMIN) can hand their seat to another
// resident of the same community. This only takes effect once:
//   1) every OTHER committee member in the community approves, then
//   2) the chosen resident themselves accepts.
// Any single rejection (by a committee member or the recipient) kills it.
// ---------------------------------------------------------------------------

model CommitteeTransferRequest {
  id           String                 @id @default(uuid())
  communityId  String
  fromUserId   String
  toResidentId String
  status       TransferRequestStatus  @default(PENDING_COMMITTEE)
  recipientDecision ApprovalDecision  @default(PENDING)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  resolvedAt   DateTime?

  community  Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  fromUser   User       @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toResident Resident   @relation("TransferTo", fields: [toResidentId], references: [id], onDelete: Cascade)
  approvals  CommitteeTransferApproval[]

  @@index([communityId])
  @@index([toResidentId])
  @@map("committee_transfer_requests")
}

model CommitteeTransferApproval {
  id              String            @id @default(uuid())
  // Denormalized from request.communityId — see migration
  // 20260908000000_communityid_everywhere.
  communityId     String
  requestId       String
  committeeUserId String
  decision        ApprovalDecision  @default(PENDING)
  respondedAt     DateTime?

  community Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  request CommitteeTransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  member  User                     @relation(fields: [committeeUserId], references: [id], onDelete: Cascade)

  @@unique([requestId, committeeUserId])
  @@index([communityId])
  @@map("committee_transfer_approvals")
}

// ---------------------------------------------------------------------------
// GENERALIZED SENSITIVE-CHANGE APPROVAL
//
// Any action a single committee member shouldn't be able to make unilaterally
// routes through here: a PendingChange is created instead of applying
// directly, every OTHER committee member gets an approval row, one rejection
// kills it, and it only actually applies once everyone has approved or it
// auto-expires after 24h. See src/utils/pendingChanges.js for the apply-diff
// logic per changeType and src/controllers/pendingChangeController.js for
// the shared submit/approve/reject/list flow.
// ---------------------------------------------------------------------------

enum PendingChangeStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model PendingChange {
  id          String              @id @default(uuid())
  communityId String
  // Tag identifying what kind of sensitive action this is, e.g.
  // "COMMUNITY_PAYMENT_DETAILS". A string rather than an enum on purpose —
  // registering a new sensitive-change type shouldn't require a migration,
  // just a new case in applyPendingChange().
  changeType  String
  // Which real row this will be applied to once approved.
  entityType  String
  entityId    String
  // { fieldName: { from, to }, ... } — single source of truth for both what
  // reviewers see and what gets applied on final approval.
  diff        Json
  status      PendingChangeStatus @default(PENDING)
  proposedById String
  createdAt   DateTime            @default(now())
  expiresAt   DateTime
  resolvedAt  DateTime?

  community  Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  proposedBy User                    @relation("PendingChangeProposedBy", fields: [proposedById], references: [id], onDelete: Cascade)
  approvals  PendingChangeApproval[]

  @@index([communityId, status])
  @@index([entityType, entityId, status])
  @@map("pending_changes")
}

model PendingChangeApproval {
  id              String           @id @default(uuid())
  // Denormalized from pendingChange.communityId — see migration
  // 20260908000000_communityid_everywhere.
  communityId     String
  pendingChangeId String
  committeeUserId String
  decision        ApprovalDecision @default(PENDING)
  respondedAt     DateTime?
  // True when this approval was filled in automatically because the member
  // had a matching CommitteeAutoApproval enabled at creation time, rather
  // than an explicit click. Kept even if the standing setting is later
  // disabled, so historical requests still show accurately how they were
  // approved.
  autoApproved    Boolean          @default(false)

  community     Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  pendingChange PendingChange @relation(fields: [pendingChangeId], references: [id], onDelete: Cascade)
  member        User          @relation(fields: [committeeUserId], references: [id], onDelete: Cascade)

  @@unique([pendingChangeId, committeeUserId])
  @@index([communityId])
  @@map("pending_change_approvals")
}

// Lets a committee member pre-authorize their own vote on future
// PendingChanges of a given changeType, so they don't have to manually
// approve every single low-stakes request. Scoped per (user, changeType) —
// enabling it for PROJECT_BUDGET says nothing about PROJECT_CANCELLATION.
// Always has an expiry; there is no indefinite/forever option by design.
// When a PendingChange is created, createPendingChange() checks this table
// per approver and, if an enabled/non-expired row exists, immediately
// marks that member's PendingChangeApproval as APPROVED with a note that
// it was auto-approved — same audit trail as a manual approval, just
// attributed differently, so the member is still accountable if the
// standing approval is later found to have waved through something bad.
model CommitteeAutoApproval {
  id          String   @id @default(uuid())
  userId      String
  communityId String
  changeType  String
  enabled     Boolean  @default(false)
  // Required — user picks "for how many days", we store the resulting
  // cutoff. Once past this, auto-approval silently stops applying (the
  // row is left in place, not deleted, so the settings page can show it
  // as "expired" rather than just vanishing).
  expiresAt   DateTime
  // Timestamp of when the user clicked through the accountability warning
  // for this specific (re-)enable action. Required server-side whenever
  // enabled is set to true, so the warning can't be silently bypassed by
  // a direct API call that skips the confirmation dialog.
  acknowledgedAt DateTime
  // Who this auto-approval applies to, by proposer. Empty array (the
  // default) means "anyone" — matches the original blanket behavior. A
  // non-empty array narrows it to only auto-approve requests proposed by
  // those specific committee members (userId of the OTHER admin who
  // proposed the change), everyone else still needs an explicit vote from
  // this user. Checked in pendingChangeController alongside changeType.
  scopedToUserIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, changeType])
  @@index([communityId])
  @@map("committee_auto_approvals")
}

// ---------------------------------------------------------------------------
// PLATFORM ADMINISTRATION — completely separate identity/auth boundary from
// the community-facing User/ADMIN/RESIDENT system above. A PlatformAdmin is
// an Oudaa *operator* (internal staff running the SaaS itself), never a
// community's own committee member or resident, and has no `communityId` of
// their own. Nothing here should ever be reachable via the community JWT
// (see middleware/platformAdmin/authenticatePlatformAdmin.js), and nothing
// on the community side should ever be reachable via a platform token — the
// two are deliberately kept from sharing a session model, a cookie name, or
// a JWT secret so a bug in one auth boundary can't fall through to the other.
// ---------------------------------------------------------------------------

// Granular role a platform operator is assigned. Permissions themselves are
// defined in code (src/config/platformPermissions.js) as a role -> permission
// map, not as a separate normalized table — Phase 1 only needs to *enforce*
// permission checks, not let operators redefine what each role can do from
// the UI (that would itself need its own audited change-control flow, out
// of scope here). Keeping the mapping in version-controlled code also means
// a permission change is itself code-reviewed and deployed, not a silent
// runtime DB edit.
enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_AGENT
  OPERATIONS
  SECURITY_AUDITOR
  FINANCE_OPERATOR
}

model PlatformAdmin {
  id           String       @id @default(uuid())
  fullName     String
  email        String       @unique
  passwordHash String
  role         PlatformRole @default(SUPPORT_AGENT)
  isActive     Boolean      @default(true)

  // --- MFA foundation (Phase 1: data model + verify/recovery flow; making
  // it mandatory for privileged roles is enforced by requireMfa middleware
  // once an operator has actually enrolled). Secret is stored encrypted at
  // rest by the application layer (see utils/platformMfa.js), never in
  // plaintext, and never returned by any API response.
  mfaEnabled        Boolean   @default(false)
  mfaSecretEnc      String?
  // Hashed (not plaintext) one-time recovery codes, same pattern as
  // password/refresh tokens elsewhere in this schema — a DB leak alone
  // must not be usable to bypass MFA. Each entry is consumed (removed) on
  // use.
  mfaRecoveryCodeHashes Json? @default("[]")
  mfaEnrolledAt     DateTime?

  // --- login/lockout tracking
  lastLoginAt          DateTime?
  lastLoginIp          String?
  lastFailedLoginAt    DateTime?
  lastFailedLoginIp    String?
  failedLoginCount     Int       @default(0)
  lockedUntil          DateTime?

  // --- Phase 6: forced re-credentialing, set by another SUPER_ADMIN via
  // /platform-admins/:id/require-password-reset and
  // /platform-admins/:id/require-mfa-reenrollment. Enforced by
  // requireMustChangePassword / requireMfa respectively — a flagged admin
  // can reach ONLY the endpoint needed to clear the flag until it's
  // cleared, same "narrow escape hatch" pattern as mandatory-MFA-but-not-
  // yet-enrolled in requireMfa.
  mustChangePassword       Boolean   @default(false)
  mfaReenrollmentRequired  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions   PlatformAdminSession[]
  auditLogs  PlatformAuditLog[]
  supportViews PlatformSupportView[]
  assignedSupportTickets SupportTicket[]
  supportTicketMessages  SupportTicketMessage[]
  notificationReads     PlatformNotificationRead[]
  exportJobs             PlatformExportJob[]

  @@index([role])
  @@map("platform_admins")
}

// A single refresh/session record per logged-in device, mirroring the
// community-side RefreshToken pattern (only a hash of the raw token is ever
// stored) but kept in its own table so revoking/inspecting platform
// sessions never touches — or is confused with — community sessions.
// `mfaVerified` and `authTime` back requireMfa / requireRecentReauthentication:
// a session only counts as MFA'd or "freshly authenticated" for as long as
// this row says so, independent of the short-lived access token's own claims.
model PlatformAdminSession {
  id              String    @id @default(uuid())
  platformAdminId String
  tokenHash       String    @unique
  ipAddress       String?
  userAgent       String?
  mfaVerified     Boolean   @default(false)
  // When this session last completed a full password (+ MFA, if enabled)
  // authentication — as opposed to merely refreshing an access token.
  // requireRecentReauthentication compares "now" against this, not against
  // createdAt, so a long-lived-but-idle session can be forced to
  // re-authenticate before, e.g., changing another admin's role.
  authenticatedAt DateTime  @default(now())
  expiresAt       DateTime
  revoked         Boolean   @default(false)
  revokedAt       DateTime?
  lastUsedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@map("platform_admin_sessions")
}

// Append-only. Nothing in the platform-admin API surface may UPDATE or
// DELETE a row here (see controllers/platformAdmin — there simply is no
// such route), so the audit trail can't be edited from the admin UI even
// by a SUPER_ADMIN.
model PlatformAuditLog {
  id              String    @id @default(uuid())
  actorId         String?
  actorEmail      String?
  actorRole       PlatformRole?
  action          String    // e.g. LOGIN_SUCCESS, LOGIN_FAILED, ROLE_CHANGED
  entityType      String    // e.g. PlatformAdmin, PlatformAdminSession, Community
  entityId        String?
  // Set when the action concerned a specific tenant (e.g. COMMUNITY_VIEWED)
  // — intentionally NOT a foreign key to Community. Platform audit history
  // must survive a community being hard-deleted, and this table must never
  // gain a write-path back into tenant data.
  communityId     String?
  description     String
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  requestId       String?
  success         Boolean   @default(true)
  createdAt       DateTime  @default(now())

  actor PlatformAdmin? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@index([communityId])
  @@map("platform_audit_logs")
}

// ---------------------------------------------------------------------------
// PLATFORM SUPPORT VIEW SESSIONS (Phase 3 — View-As)
//
// A short-lived, read-only "operator window" into a community user's account.
// Each session is created explicitly by an authorized platform operator,
// generates a PlatformAuditLog entry, carries a hard expiry, and can never
// grant write access or expose secrets (passwordHash, mfaSecretEnc, etc.).
// NOT a foreign key back to User (community tenant) because cross-schema
// references weaken the tenant boundary; we store the user's id/email/role
// as plain strings, same pattern as PlatformAuditLog.communityId.
// ---------------------------------------------------------------------------
model PlatformSupportView {
  id              String    @id @default(uuid())
  // Operator who initiated the view
  operatorId      String
  operatorEmail   String
  // Target community user (NOT a FK — tenant boundary)
  targetUserId    String
  targetEmail     String
  targetCommunityId String
  // Every session has a hard deadline — checked server-side on every read
  expiresAt       DateTime
  // Revoked early (logout / admin revoke) even if not yet expired
  revoked         Boolean   @default(false)
  revokedAt       DateTime?
  // Audit trail
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  operator PlatformAdmin @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([targetUserId])
  @@index([expiresAt])
  @@map("platform_support_views")
}

// ---------------------------------------------------------------------------
// PLATFORM PERFORMANCE MONITORING (Phase 5)
//
// PlatformMetricSnapshot: persisted every 5 minutes by the background
// collector in server.js. Used for historical trend charts (7d/30d windows
// where the in-memory ring buffer doesn't reach far enough).
//
// PlatformErrorLog: one row per 4xx/5xx response, written by the global
// error handler. Safe by design: no request bodies, tokens, or stack traces;
// endpoint is normalised to strip IDs (:id). Retained for 30 days
// (purge at the application layer — no DB-level TTL in Postgres without
// a scheduled job or pg_cron, so we simply query with a time filter and
// expose a cleanup route for ops).
// ---------------------------------------------------------------------------

model PlatformMetricSnapshot {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  requestCount   Int
  errorCount     Int
  averageLatency Float
  p95Latency     Float
  cpuPercent     Float?
  memoryUsedMb   Float
  dbLatencyMs    Float?
  activeSessions Int
  collectedBy    String?  // e.g. "pid:12345" — not a secret; informational only

  @@index([timestamp])
  @@map("platform_metric_snapshots")
}

// ---------------------------------------------------------------------------
// PLATFORM SECURITY SETTINGS (Phase 6)
//
// Single-row table (fixed id "default") holding the *adjustable* security
// knobs — the ones that are genuinely safe to change at runtime through
// the admin UI. Deliberately does NOT include the permission catalog or
// role→permission map (see config/platformPermissions.js's header comment
// for why those stay in code) and does NOT include MFA_MANDATORY_ROLES —
// which roles MUST have MFA is a code-level security invariant, not a
// runtime toggle. `mfaRequiredForAllAdmins` here is an ADDITIONAL,
// operator-controlled layer on top of that hard-coded floor, never a way
// to loosen it.
// ---------------------------------------------------------------------------
model PlatformSecuritySettings {
  id String @id @default("default")

  // Applied to newly-issued sessions going forward only (see
  // platformAuthController) — does not retroactively shorten sessions
  // already issued.
  sessionDurationMinutes Int @default(43200) // 30 days

  passwordMinLength        Int     @default(12)
  passwordRequireUppercase Boolean @default(true)
  passwordRequireNumber    Boolean @default(true)
  passwordRequireSymbol    Boolean @default(false)

  // Read by the platform auth rate limiter on every request (function-based
  // `max`, see routes/platformAdmin/platformAuthRoutes.js), so this DOES
  // take effect immediately without a process restart.
  loginRateLimitMax           Int @default(10)
  loginRateLimitWindowMinutes Int @default(15)

  // Additional-only, see header comment above.
  mfaRequiredForAllAdmins Boolean @default(false)

  // Origins allowed to embed/call the platform console from, beyond the
  // app's own CORS_ORIGIN env var. Informational/allow-list data for
  // future enforcement points; not currently wired into the CORS
  // middleware itself (see Phase 6 completion report — security
  // limitations).
  trustedOrigins Json @default("[]")

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("platform_security_settings")
}


// ---------------------------------------------------------------------------
// PLATFORM OPERATIONS & CONTROL CENTER (Phase 7)
// ---------------------------------------------------------------------------

enum PlatformAnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum PlatformAnnouncementType {
  INFO
  WARNING
  MAINTENANCE
  SECURITY
}

enum PlatformNotificationSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum PlatformExportType {
  COMMUNITIES
  USERS
  AUDIT_LOGS
  SUPPORT_TICKETS
  FINANCIAL_AGGREGATE
}

enum PlatformExportFormat {
  CSV
  XLSX
  JSON
}

enum PlatformExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model PlatformFeatureFlag {
  id                 String   @id @default(uuid())
  key                String
  description        String?
  enabled            Boolean  @default(false)
  environment        String   @default("production")
  rolloutPercentage  Int      @default(100)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  targets PlatformFeatureFlagTarget[]

  @@unique([key, environment])
  @@index([environment])
  @@index([enabled])
  @@map("platform_feature_flags")
}

model PlatformFeatureFlagTarget {
  featureFlagId String
  communityId   String

  featureFlag PlatformFeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([featureFlagId, communityId])
  @@index([communityId])
  @@map("platform_feature_flag_targets")
}

model PlatformMaintenance {
  id                    String   @id @default("default")
  enabled               Boolean  @default(false)
  message               String   @default("The platform is temporarily unavailable while maintenance is performed.")
  expectedDurationMins  Int?
  allowPlatformAdmins   Boolean  @default(true)
  allowSupportAgents    Boolean  @default(true)
  enabledAt             DateTime?
  disabledAt            DateTime?
  updatedAt             DateTime @updatedAt
  updatedById           String?

  @@map("platform_maintenance")
}

model PlatformAnnouncement {
  id           String                    @id @default(uuid())
  title        String
  message      String                    @db.Text
  type         PlatformAnnouncementType  @default(INFO)
  status       PlatformAnnouncementStatus @default(DRAFT)
  scheduledFor DateTime?
  publishedAt  DateTime?
  expiresAt    DateTime?
  targetAll    Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  targets PlatformAnnouncementTarget[]

  @@index([status])
  @@index([scheduledFor])
  @@index([expiresAt])
  @@map("platform_announcements")
}

model PlatformAnnouncementTarget {
  announcementId String
  communityId    String

  announcement PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  community    Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([announcementId, communityId])
  @@index([communityId])
  @@map("platform_announcement_targets")
}

model PlatformNotification {
  id          String                       @id @default(uuid())
  type        String
  severity    PlatformNotificationSeverity @default(INFO)
  title       String
  message     String                       @db.Text
  route       String?
  metadata    Json?
  createdAt   DateTime                     @default(now())
  expiresAt   DateTime?

  reads PlatformNotificationRead[]

  @@index([createdAt])
  @@index([severity])
  @@map("platform_notifications")
}

model PlatformNotificationRead {
  notificationId String
  adminId        String
  readAt         DateTime @default(now())

  notification PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin        PlatformAdmin        @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([notificationId, adminId])
  @@index([adminId, readAt])
  @@map("platform_notification_reads")
}

model PlatformExportJob {
  id              String             @id @default(uuid())
  type            PlatformExportType
  format          PlatformExportFormat
  status          PlatformExportStatus @default(QUEUED)
  filters         Json?
  requestedById   String
  filePath        String?
  contentType     String?
  fileName        String?
  sizeBytes       Int?
  errorMessage    String?
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?

  requestedBy PlatformAdmin @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@map("platform_export_jobs")
}

model PlatformConfigSetting {
  id          String   @id @default(uuid())
  category    String
  key         String
  valueJson   Json?
  description String?
  isSensitive Boolean  @default(false)
  managedBy   String   @default("DATABASE")
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([category, key])
  @@index([category])
  @@map("platform_config_settings")
}

model PlatformIntegrationEvent {
  id            String   @id @default(uuid())
  integration   String
  operation     String
  success       Boolean
  latencyMs     Int?
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([integration, createdAt])
  @@index([integration, success, createdAt])
  @@map("platform_integration_events")
}

model PlatformErrorLog {
  id              String   @id @default(uuid())
  timestamp       DateTime @default(now())
  requestId       String?  // X-Request-Id — links to logs and audit records
  method          String
  endpoint        String   // normalised (IDs replaced with :id)
  statusCode      Int
  errorCategory   String
  errorMessage    String
  communityId     String?  // NOT a FK — tenant boundary; null for platform-admin errors
  userId          String?  // community user id — NOT a FK (same reason)
  platformAdminId String?  // platform admin id — NOT a FK (same reason)
  latencyMs       Int?

  @@index([timestamp])
  @@index([statusCode])
  @@index([endpoint])
  @@index([communityId])
  @@map("platform_error_logs")
}
