NODE_ENV=development
PORT=4000

# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://oudaa_user:oudaa_password@localhost:5432/oudaa_db

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=14d

CORS_ORIGIN=http://localhost:5173
# In production this MUST be your real deployed frontend URL (comma-separate
# multiple origins if needed, e.g. prod + a preview URL). It cannot be left
# unset/wildcard: auth relies on a credentialed (cookie) cross-origin
# request, which browsers refuse to allow against a wildcard origin.

# ---------------------------------------------------------------------------
# PLATFORM ADMINISTRATION CONSOLE — a completely separate operator identity/
# auth boundary from the community app above (see prisma/schema.prisma's
# "PLATFORM ADMINISTRATION" section and src/routes/platformAdmin).
# ---------------------------------------------------------------------------

# The platform-admin console's own origin allowlist. Deliberately NOT the
# same variable as CORS_ORIGIN above — an origin allowed to call the
# community API must not thereby be allowed to call platform-admin
# endpoints. Comma-separate multiple origins. In production this should be
# the console's own domain, e.g. https://admin.example.com — see PHASE 1's
# "Admin domain" section for the eventual separate-subdomain deployment.
PLATFORM_ADMIN_CORS_ORIGIN=http://localhost:5174

# Separate JWT secrets from JWT_ACCESS_SECRET/JWT_REFRESH_SECRET above —
# must never be the same value. A leaked platform secret (or accidental
# reuse) must not let anyone forge a token for the other boundary.
PLATFORM_JWT_ACCESS_SECRET=replace_with_a_long_random_secret_DIFFERENT_from_JWT_ACCESS_SECRET
PLATFORM_JWT_REFRESH_SECRET=replace_with_a_long_random_secret_DIFFERENT_from_JWT_REFRESH_SECRET
# Short-lived by design (platform tokens are far more sensitive than
# community ones) — see src/utils/platformTokens.js.
PLATFORM_JWT_ACCESS_EXPIRES_IN=10m
# Phase 7 async platform-export worker. Jobs are persisted in Postgres so the API
# request never waits for the export to finish. Use durable shared storage/object
# storage in production; local disk is suitable for development/single-instance use.
# Must point to durable mounted storage in production (for example, a persistent disk path).
PLATFORM_EXPORT_DIR=
PLATFORM_EXPORT_WORKER_INTERVAL_MS=5000

PLATFORM_JWT_REFRESH_EXPIRES_IN=8h

# 32-byte (or any string — it's hashed down to 32 bytes) key used to encrypt
# each platform admin's TOTP MFA secret at rest (AES-256-GCM). Generate with:
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PLATFORM_MFA_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Base URL of the deployed frontend, used to build the link inside
# password-reset emails (e.g. https://app.example.com/reset-password?token=...).
FRONTEND_URL=http://localhost:5173

# OCR.space API key — fallback text-extraction path, only used if the Groq
# vision path below isn't configured or fails on a given upload.
# (https://ocr.space/ocrapi — free tier key works for testing).
OCRSPACE_API_KEY=replace_with_your_ocrspace_api_key

# Groq API key — primary path: a Groq vision model reads the payment
# screenshot directly and extracts labeled fields (amount, sender name,
# transaction ID, bank name, date). Falls back to OCR.space text extraction
# (+ this same key, used to classify that text) if unset or a call fails.
# If completely unset, the app falls back further to regex-only extraction
# (txnId + name only, no amount/bank/date) with no error to the user.
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_replace_me
# GROQ_MODEL=openai/gpt-oss-120b
# Vision model used for the direct-image extraction path (no OCR.space
# call at all). Defaults to qwen/qwen3.6-27b if unset. Check
# https://console.groq.com/docs/models for the current multimodal lineup —
# Groq's vision model lineup is retired/replaced often.
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
#
# "Ask Oudaa AI" — the Help & Support chat assistant (src/utils/
# supportAiAssistant.js) — reuses the same GROQ_API_KEY above. Optionally
# point it at a different (currently-active) Groq model than receipt
# parsing; defaults to GROQ_MODEL, then openai/gpt-oss-120b, if unset.
# SUPPORT_AI_MODEL=openai/gpt-oss-120b
#
# NOTE: llama-3.1-8b-instant and llama-3.3-70b-versatile were retired by
# Groq (fully shut down Aug 16, 2026) — do not set GROQ_MODEL to either of
# these, calls will 404 with "model_not_found". If you deployed with one of
# these set in your hosting provider's env vars (e.g. Render), update or
# unset it there — the code now ignores/warns on retired model IDs and
# falls back to the default above, but it's cleaner to fix at the source.
# Check https://console.groq.com/docs/models for the current model list.

# Outbound email (e.g. resident-deactivation notices, password resets),
# sent via Brevo's transactional email HTTP API — see src/utils/email.js
# and https://developers.brevo.com/docs/send-a-transactional-email.
# This is a plain HTTPS API call, no SMTP socket involved, which avoids
# the "Connection timeout" problems raw SMTP has from PaaS hosts like
# Render (their network resolves many SMTP hosts' IPv6 records but can't
# actually route to them).
#
# If either of these is unset, src/utils/email.js runs in STUB MODE —
# emails are logged to the console instead of actually sent, so local
# dev works without real mail credentials.
#
# BREVO_API_KEY: from Brevo > Settings > SMTP & API > API Keys.
# BREVO_SENDER_EMAIL: must be a verified sender/domain in your Brevo
#   account (see https://developers.brevo.com/docs/sender-creation-and-management).
# BREVO_SENDER_NAME: optional display name, defaults to "Oudaa".
# BREVO_API_KEY=xkeysib-replace_me
# BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# BREVO_SENDER_NAME="Oudaa"

# Bank transaction verification, via Veritas (https://veritas.et) — an
# UNOFFICIAL third-party Ethiopian payment-verification service (not the
# banks themselves). Required for src/utils/bankVerification.js to do real
# lookups; without it, the app falls back to STUB MODE and logs a loud
# warning on boot (see server.js) — self-verified payments are NOT checked
# against a real bank in that mode.
# VERITAS_API_KEY=sk_live_replace_me
# Only set this if you're running your own Veritas API fork — otherwise
# leave unset to use the hosted API (https://verifyapi.leulzenebe.pro).
# VERITAS_API_URL=

# Supabase Storage, for receipt file uploads. Required in production
# (e.g. on Render, whose filesystem is ephemeral and wipes local uploads
# on every deploy/restart) — without these, receipts fall back to local
# disk storage, which is fine for local dev only. Use the SERVICE ROLE
# key (Project Settings -> API in the Supabase dashboard), not the anon
# key — uploads happen from trusted backend code after our own auth
# middleware, not directly from the browser.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
# Storage bucket to upload receipts into. Create it in the Supabase
# dashboard (Storage -> New bucket) — "Public" so fileUrl works directly
# in <img>/<a> tags without needing signed URLs. Defaults to "receipts".
# SUPABASE_RECEIPTS_BUCKET=receipts

# Production safety gates. Keep these unset/false on ephemeral hosts.
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
# ALLOW_PAYMENT_VERIFICATION_STUB_IN_PRODUCTION=false

# Platform telemetry retention (days). Audit logs are intentionally not part of this TTL cleanup.
# PLATFORM_ERROR_LOG_RETENTION_DAYS=30
# PLATFORM_INTEGRATION_EVENT_RETENTION_DAYS=90
# PLATFORM_METRIC_SNAPSHOT_RETENTION_DAYS=90
