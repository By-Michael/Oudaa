# In dev, Vite proxies /api -> http://localhost:4000 (see vite.config.js), so this can stay unset.
# In production, point this at your deployed backend's API base.
VITE_API_URL=http://localhost:4000/api/v1

# The base domain communities are reached at, e.g. acme.oudaa.app when this
# is "oudaa.app" — see src/lib/subdomain.js. On localhost this has no
# effect (subdomain detection is skipped entirely there), so it only
# matters once you're deployed behind real DNS.
VITE_APP_BASE_DOMAIN=oudaa.app
